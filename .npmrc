# vp install / pnpm settings (do NOT put these under package.json "pnpm" —
# modern pnpm ignores that field and prints a WARN).
#
# Allow newly published transitive deps (avoids
# ERR_PNPM_MINIMUM_RELEASE_AGE_VIOLATION).
minimum-release-age=0
engine-strict=false

# Permit esbuild's postinstall (needed by vite / vp build).
only-built-dependencies[]=esbuild
